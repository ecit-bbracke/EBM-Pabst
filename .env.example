# =================================================================
# Document RAG System - Linux Environment Configuration
# =================================================================

# Google Gemini API Key (Required for LLM and Embedding services)
GEMINI_API_KEY=your_gemini_api_key_here

# ASP.NET / .NET Environment (Production, Staging, Development)
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production

# Qdrant Vector Database Configuration
Qdrant__ConnectionString=http://qdrant:6334
Qdrant__CollectionName=production-chunks

# Port Configuration (Defaults: HTTP=8080, HTTPS/Admin=8081)
# WEBAPI_HTTP_PORT=8080
# WEBAPI_HTTPS_PORT=8081
