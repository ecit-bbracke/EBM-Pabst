[Unit]
Description=Document RAG System - Worker Service
After=network.target qdrant.service document-rag-webapi.service

[Service]
Type=simple
User=ragapp
WorkingDirectory=/opt/document-rag-system
ExecStart=/opt/document-rag-system/worker/DocumentRagSystem.Worker
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=document-rag-worker
Environment=DOTNET_ENVIRONMENT=Production
EnvironmentFile=-/opt/document-rag-system/.env

[Install]
WantedBy=multi-user.target
